! =========================================
! VoIP Sub-Interface Yapılandırması
! Erciyes Üniversitesi Kampüs Ağı
! =========================================

configure terminal

interface gigabitEthernet 0/0.200
  encapsulation dot1Q 200
  ip address 10.10.200.1 255.255.255.0
exit

interface gigabitEthernet 0/0
  no shutdown
exit

do write memory
